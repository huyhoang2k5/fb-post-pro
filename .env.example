# ========================================================
# FB Post Pro - Environment Variables
# ========================================================

# Database (PostgreSQL)
# e.g., Local PostgreSQL, Supabase, Neon.tech, or Docker
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/fb_post_pro?schema=public"

# Background Job Queue (Redis + BullMQ)
REDIS_URL="redis://localhost:6379"

# Authentication & Base URL
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="fb_post_pro_super_secure_auth_secret_key_987654321"

# Meta Developer App (Graph API v20.0+)
# Lấy từ: https://developers.facebook.com/apps/
FACEBOOK_APP_ID="your_meta_app_id"
FACEBOOK_APP_SECRET="your_meta_app_secret"
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/facebook/callback"

# Media Storage (Cloudinary - Tùy chọn nếu muốn lưu ảnh đám mây công khai cho Meta)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Application Environment
NODE_ENV="development"
PORT=3000
